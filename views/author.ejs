<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Author Details</title>
</head>
<body>
  <h1><%= author.name %></h1>

  <% for (let book of author.books) { %>
    <h4><%= book.name %></h4>
    <p><%= book.nof_pages %> pages</p>
  <% } %>
  <a href="/">Return home</a>
</body>
</html>

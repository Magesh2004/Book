<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Author Details</title>
</head>
<body>
  <h1><%= author.name %></h1>
  <p><%= author.bio  %></p>
  <a href="/">Return home</a>
  <a href="/books/<%= author._id  %>/edit">Edit</a>
  <form action="/books/<%= author._id%>/del?_method=DELETE" method="post"><button type="submit">DELETE</button></form>


  <% for (let book of author.books) { %>
    <h4><%= book.name %></h4>
    <p><%= book.nof_pages %> pages</p>
    <div>
      <a href="/books/<%= author._id%>/edit/<%= book._id%>">Edit book</a>
      <form action="/books/<%= author._id%>/<%= book._id%>/del?_method=DELETE" method="post"><button type="submit">DELETE</button></form>
    </div>
  <% } %>
  <hr>
    <h1>Add a new book</h1>
    <form action="/books/<%= author.id %>" method="post">
        <label for="name">Book name </label>
        <input type="text" id="name" name="book[name]" >
        <label for="pages">No of pages </label>
        <input type="text" id="pages" name="book[nof_pages]" >
        <button type="submit">Add book</button>
    </form>
    
</body>
</html>

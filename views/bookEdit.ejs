<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Updating book</h1>
    <form action="/books/<%= book.author%>/edit/<%= book._id%>?_method=PUT" method="post">
        <label for="name">Book name </label>
        <input type="text" id="name" name="book[name]" value="<%= book.name %>">
        <label for="pages">No of pages </label>
        <input type="text" id="pages" name="book[nof_pages]" value="<%= book.nof_pages %>">
        <button type="submit">Update</,button>
    </form>
</body>
</html>